# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Configurable Verified Business Details (leave blank if unconfigured)
BUSINESS_LOCATION=""
BUSINESS_PHONE=""
BUSINESS_EMAIL=""

# Optional SMTP Delivery Configuration for Service Request Form
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
CONTACT_FROM_EMAIL=""
CONTACT_RECIPIENT_EMAIL=""

# Optional CSRF Signing Secret (auto-generated in memory if omitted)
CSRF_SECRET=""
